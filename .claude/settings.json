{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/guard.sh",
            "statusMessage": "Checking command..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import json,sys,subprocess as p; d=json.load(sys.stdin); f=d.get('tool_input',{}).get('file_path',''); f.endswith('.py') and p.run([sys.executable,'-m','black',f])\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/run_tests.py",
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  }
}
